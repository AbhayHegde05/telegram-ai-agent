# Telegram Movie Assistant Bot - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env with real values to version control!

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: Groq API Key from https://console.groq.com
GROQ_API_KEY=

# Optional: Groq Model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Required: Tavily API Key for search
TAVILY_API_KEY=

# Required: Supabase credentials for persistent memory
SUPABASE_URL=
SUPABASE_KEY=

# Required for setting webhook via /api/set_webhook
WEBHOOK_URL=
