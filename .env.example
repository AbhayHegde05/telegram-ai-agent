# Telegram Movie Assistant Bot - Environment Variables
# Copy this file to .env and fill in your values

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: Groq API Key from https://console.groq.com
GROQ_API_KEY=

# Optional: Groq API Base URL (default: https://api.groq.com)
GROQ_BASE_URL=https://api.groq.com

# Optional: Groq Model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
