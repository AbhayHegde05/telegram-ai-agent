{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      "docker/**",
      "workflow-assets/**",
      "workflows/**",
      "supabase/**",
      "docs/**",
      ".env.example",
      "README.md",
      "scripts/**"
    ]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/healthz/readiness",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 30
  }
}

